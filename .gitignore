# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
/dist/
/build/

# ---- 虚拟环境 / uv ----
.venv/
venv/
# 注意: uv.lock 需纳入版本控制 (见 AGENTS.md), 不要忽略

# ---- 缓存 ----
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# ---- 环境变量 / 密钥 ----
.env
*.env
!.env.example

# ---- 编辑器 / 系统 ----
.idea/
.vscode/
.DS_Store
*.swp
*.swo

# ---- 日志 ----
logs/
*.log

# ---- 实验追踪 ----
/wandb/
/mlruns/
/outputs/

# ---- 数据 / 模型 / checkpoint 产物 (仅忽略仓库根下的产物目录, 避免误伤同名源码包如 src/veritool_rl/data/) ----
/data/
/datasets/
/models/
/checkpoints/
/weights/
/pretrained/
/hub/
/.cache/
/cache/

# ---- 训练运行目录中的 adapter / checkpoint（报告指标保留，权重与训练状态不进 git） ----
/reports/**/adapter/
/reports/**/checkpoints/

# BFCL 官方 score / 失败明细嵌入原始 prompt、schema 和 possible answer，不进 git
/reports/bfcl/**/official_scores/
/reports/bfcl/**/failures.jsonl
# 单任务 GPU smoke 仅作运行前全链路验证，保留在本地和远程产物目录
/reports/bfcl/*-smoke-*/

# ---- 权重文件 (任意位置, 不进 git) ----
*.bin
*.safetensors
*.gguf
*.ggml
*.pt
*.pth
*.onnx
*.h5
*.pkl
